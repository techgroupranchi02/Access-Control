# Database Configuration
DB_CONNECTION=mysql
DB_HOST=localhost
DB_PORT=3306
DB_DATABASE=access_control_database
DB_USERNAME=your_db_user
DB_PASSWORD=your_db_password

# Application
APP_PORT=4000
NODE_ENV=development
FRONTEND_URL=http://localhost:5173

# JWT — Generate a strong secret for production!
# JWT_SECRET_KEY=your-production-secret-here

# Outgoing email: the updated delegate confirmation (docs/adr/0006). Same keys and account as the
# Freecomers Laravel .env; without MAIL_HOST no email is sent.
MAIL_HOST=
MAIL_PORT=465
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_ENCRYPTION=tls
MAIL_FROM_ADDRESS=
MAIL_FROM_NAME="Freecomers"

# Public Freecomers site for festival page links (defaults: next.autovertest.com on autovertest, else freecomers.com)
# FREECOMERS_SITE_URL=
